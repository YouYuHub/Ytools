flowchart TD
    A["编写源码 (.py)"] --> B["词法与语法解析"]
    B --> C{"语法是否有错?"}
    C -- "有错" --> D["报错提示 SyntaxError"]
    D --> A
    C -- "无错" --> E["编译为字节码 (.pyc)"]
    E --> F["import 模块加载"]
    F --> G["CPython 虚拟机逐条解释执行"]
    G --> H{"遇到函数调用?"}
    H -- "是" --> I["压栈执行函数体"]
    I --> J["返回值并出栈"]
    J --> K{"是否发生运行时异常?"}
    H -- "否" --> K
    K -- "是" --> L["try/except 异常处理"]
    L --> M{"异常已捕获?"}
    M -- "否" --> N["程序异常终止"]
    M -- "是" --> O["引用计数 + 垃圾回收 释放内存"]
    K -- "否" --> O
    O --> P["程序正常结束"]
