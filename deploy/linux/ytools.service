[Unit]
Description=Ytools authenticated workspace
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ytools
Group=ytools
WorkingDirectory=/opt/ytools/app
EnvironmentFile=/etc/ytools/ytools.env
ExecStart=/opt/ytools/venv/bin/python /opt/ytools/app/scripts/serve.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=25
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/ytools/app /var/lib/ytools
RestrictSUIDSGID=true
LockPersonality=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
