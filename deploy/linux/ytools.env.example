# Copy to /etc/ytools/ytools.env, owner root:ytools, mode 0640.
# This example contains no login password or model credential.
YTOOLS_DEPLOYMENT=production
YTOOLS_PUBLIC_ORIGIN=https://chat.example.com
YTOOLS_SECURITY_DIR=/var/lib/ytools/security
YTOOLS_TRUSTED_OPERATORS=false
YTOOLS_ALLOWED_MEDIA_ORIGINS=
YTOOLS_PROXY_IPS=127.0.0.1,::1
DEFAULT_SERVICE_HOST=127.0.0.1
DEFAULT_SERVICE_PORT=48621
DEFAULT_CHAT_WORK_DIR=/var/lib/ytools/workspaces
PYTHONUNBUFFERED=1
