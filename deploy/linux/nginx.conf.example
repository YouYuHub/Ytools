# Replace domain/certificate paths. Backend port must not be exposed publicly.
# Include inside nginx's http {} context, then run nginx -t before reload.
limit_req_zone $binary_remote_addr zone=ytools_login:10m rate=10r/m;
limit_conn_zone $binary_remote_addr zone=ytools_connections:10m;
server {
    listen 80;
    server_name chat.example.com;
    return 308 https://chat.example.com$request_uri;
}
server {
    listen 443 ssl;
    server_name chat.example.com;
    ssl_certificate /etc/letsencrypt/live/chat.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/chat.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;
    client_max_body_size 600m;
    client_body_timeout 60s;
    limit_conn ytools_connections 40;
    # Query strings can contain preview tickets. Keep them out of access logs.
    access_log off;
    location = /auth/login {
        limit_req zone=ytools_login burst=10 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:48621;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
    location / {
        proxy_pass http://127.0.0.1:48621;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
