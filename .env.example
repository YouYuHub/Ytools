# Copy to .env and adjust for this machine. This file contains no credentials.
# The sample binds the web service to loopback; use 0.0.0.0 only on a trusted network.
DEFAULT_CHAT_WORK_DIR=
DEFAULT_SERVICE_HOST=127.0.0.1
DEFAULT_SERVICE_PORT=48621
LOG_LEVEL=info

HISTORY_COMPACT_TRIGGER_RATIO=
HISTORY_COMPACT_MAX_OVERSIZED_REJECTIONS=
HISTORY_COMPACT_SUMMARY_BUDGET_RATIO=
HISTORY_COMPACT_TARGET_TOKENS=0
HISTORY_COMPACT_REJECT_OVERSIZED_FACTOR=
HISTORY_TOOL_RESULT_RETURN_MAX_LENGTH=
REASONING_RETURN_MAX_LENGTH=

ONE_TASK_MAX_WORKERS=
MCP_DISCOVERY_MAX_CONCURRENCY=
MCP_DISCOVERY_TIMEOUT_SECONDS=
MCP_TOOL_CALL_TIMEOUT_SECONDS=
TOOL_CALL_STREAM_TIMEOUT_SECONDS=
MCP_TOOLS_CACHE_TTL_SECONDS=60

NETWORK_RETRY_MAX_ATTEMPTS=3
COMPACTION_RETRY_MAX_ATTEMPTS=2
REQUEST_HARD_LIMIT_TOKENS=1048576
STREAM_TRUNCATION_MAX_RETRIES=

SUB_AGENT_ENABLED=true
SUB_AGENT_MAX_ROUNDS=
SUB_AGENT_MAX_CONCURRENT=
SUB_AGENT_TIMEOUT_SECONDS=
SUB_AGENT_REPLY_MAX_CHARS=
SUB_AGENT_FINAL_REPLY_RETRY_MAX=
SUB_AGENT_STREAM_ERROR_RETRY_MAX=
SUB_AGENT_TODO_REMIND_MAX=

VIDEO_MAX_READ_SECONDS=
NATIVE_DOC_MAX_BYTES=
NATIVE_DOC_TOTAL_MAX_BYTES=
NATIVE_DOC_MAX_ITEMS=
FILE_TEXT_MAX_CHARS=

CHAT_WORKER_MODE=process
CHAT_WORKER_IDLE_TIMEOUT_SECONDS=900
CONFIG_HOT_RELOAD_INTERVAL_SECONDS=5
OLLAMA_MODEL_POLL_INTERVAL_SECONDS=30
OLLAMA_MODEL_DISCOVERY_TIMEOUT_SECONDS=3
USE_BACKEND_HISTORY=true
USER_NAME=
# Project-wide default for browser speech recognition (selected in Chat Settings).
SPEECH_INPUT_LANGUAGE=zh-CN
