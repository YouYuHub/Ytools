{
  "servers": {
    "PipeIpcMcp": {
      "type": "stdio",
      "command": "mcp_server/PipeIpcMCP.exe",
      "args": [],
      "version": "2.0.0"
    },
    "SysServer": {
      "type": "stdio",
      "command": "python",
      "args": [
        "mcp_server/sys_tools_server.py"
      ],
      "version": "1.0.0"
    },
    "Browser": {
      "type": "stdio",
      "command": "node",
      "args": [
        "browser/node_modules/@playwright/mcp/cli.js",
        "--headless",
        "--isolated",
        "--no-webmcp"
      ],
      "env": {
        "PLAYWRIGHT_MCP_OUTPUT_DIR": "{temp}/ytools_playwright_artifacts"
      },
      "persistent": true,
      "version": "0.0.83"
    }
  },
  "inputs": {
    "__builtin__": [
      "ask_user",
      "edit_file",
      "read_document",
      "read_file",
      "read_media",
      "run_command",
      "search_files",
      "sub_agent",
      "todo_write",
      "write_file"
    ],
    "PipeIpcMcp": [],
    "SysServer": [
      "fetch_url",
      "web_search"
    ],
    "Browser": [
      "browser_navigate",
      "browser_snapshot",
      "browser_click",
      "browser_type",
      "browser_take_screenshot",
      "browser_console_messages",
      "browser_network_requests",
      "browser_tabs"
    ]
  }
}
