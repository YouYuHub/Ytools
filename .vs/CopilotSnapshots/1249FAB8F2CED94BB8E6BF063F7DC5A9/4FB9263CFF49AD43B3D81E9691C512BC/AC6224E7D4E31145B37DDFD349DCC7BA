    def test_render_summary_block_summary_precedes_sections(self):
        rendered = render_summary_block({
            "summary": "正文开头",
            "objective": ["目标A"],
        })
        self.assertLess(rendered.index("正文开头"), rendered.index("【任务目标】"))

    def test_round_entry_to_compaction_text_keeps_tool_result(self):
        text = round_entry_to_compaction_text({
            "question": "查磁盘",
            "events": [
                {"role": "user", "content": "查磁盘"},
                {"role": "assistant", "tool_calls": [
                    {"function": {"name": "disk_info", "arguments": "{}"}}
                ]},
                {
                    "role": "tool",
                    "tool_name": "disk_info",
                    "arguments": "{}",
                    "result": "C 盘剩余 120GB",
                },
            ],
        })
        self.assertIn("[调用工具] disk_info({})", text)
        self.assertIn("【工具结果：disk_info】", text)
        self.assertIn("C 盘剩余 120GB", text)

    def test_round_compression_state_skips_compressed_tool_prefix(self):
        round_entry = {
            "question": "分两步查文件",
            "compress_content": "第一步已经完成：发现目标目录。",
            "compress_index": 1,
            "events": [
                {"role": "user", "content": "分两步查文件"},
                {"role": "assistant", "tool_calls": [
                    {"id": "call_1", "function": {"name": "list_dir_item", "arguments": "{}"}}
                ]},
                {"role": "tool", "tool_call_id": "call_1", "tool_name": "list_dir_item", "result": "旧的超长目录结果"},
                {"role": "assistant", "tool_calls": [
                    {"id": "call_2", "function": {"name": "get_file_content", "arguments": "{}"}}
                ]},
                {"role": "tool", "tool_call_id": "call_2", "tool_name": "get_file_content", "result": "第二步结果"},
                {"role": "assistant", "content": "任务继续完成。"},
            ],
        }

        text_messages = round_entry_to_context_messages(round_entry)
        self.assertEqual(text_messages[0], {"role": "user", "content": "分两步查文件"})
        self.assertIn("第一步已经完成", text_messages[1]["content"])
        self.assertNotIn("list_dir_item({})", text_messages[1]["content"])
        self.assertIn("get_file_content({})", text_messages[1]["content"])
        self.assertNotIn("旧的超长目录结果", text_messages[1]["content"])

        tool_messages = round_entry_to_context_messages(round_entry, max_tool_result_length=-1)
        self.assertEqual(tool_messages[0]["role"], "user")
        self.assertIn("第一步已经完成", tool_messages[1]["content"])
        self.assertEqual(tool_messages[2]["tool_calls"][0]["id"], "call_2")
        self.assertEqual(tool_messages[3]["content"], "第二步结果")
        self.assertEqual(tool_messages[4]["content"], "任务继续完成。")

        compaction_text = round_entry_to_compaction_text(round_entry)
        self.assertIn("第一步已经完成", compaction_text)
        self.assertIn("第二步结果", compaction_text)
        self.assertNotIn("旧的超长目录结果", compaction_text)
        self.assertNotIn("list_dir_item({})", compaction_text)

    def _tool_round_entry(self):
        return {
            "question": "查时间",
            "events": [
                {"role": "user", "content": "现在几点？"},
                {"role": "assistant", "tool_calls": [
                    {"id": "call_1", "type": "function", "function": {"name": "run_pipe_command", "arguments": "{}"}}
                ]},
                {"role": "tool", "tool_call_id": "call_1", "tool_name": "run_pipe_command", "result": "14:20"},
                {"role": "assistant", "content": "现在是 14:20"},
                {"role": "assistant", "done": "[DONE]"},
            ],
        }

    def test_round_entry_to_context_messages_tool_result_full_return(self):
        """负数表示完整回传工具结果，且符合 Chat Completions 规范（tool 消息带 tool_call_id）。"""
        messages = round_entry_to_context_messages(self._tool_round_entry(), max_tool_result_length=-1)
        self.assertEqual(len(messages), 4)
        self.assertEqual(messages[0], {"role": "user", "content": "现在几点？"})
        self.assertEqual(messages[1]["role"], "assistant")
        self.assertEqual(messages[1]["tool_calls"][0]["id"], "call_1")
        self.assertEqual(messages[1]["tool_calls"][0]["function"]["name"], "run_pipe_command")
        self.assertEqual(messages[2], {"role": "tool", "tool_call_id": "call_1", "content": "14:20"})
        self.assertEqual(messages[3], {"role": "assistant", "content": "现在是 14:20"})

    def test_round_entry_to_context_messages_tool_result_truncated(self):
        """正数表示单个工具结果截断到前 N 字符，并保留省略标记。"""
        round_entry = {
            "question": "查文件",
            "events": [
                {"role": "user", "content": "查文件"},
                {"role": "assistant", "tool_calls": [
                    {"function": {"name": "get_file_content", "arguments": "{}"}}
                ]},
                {"role": "tool", "tool_name": "get_file_content", "result": "A" * 50},
            ],
        }
        messages = round_entry_to_context_messages(round_entry, max_tool_result_length=10)
        self.assertEqual(len(messages), 3)
        tool_message = messages[-1]
        self.assertEqual(tool_message["role"], "tool")
        self.assertTrue(tool_message["content"].startswith("A" * 10))
        self.assertIn("截断", tool_message["content"])
        self.assertLess(len(tool_message["content"]), 50)

    def test_round_entry_to_context_messages_tool_result_disabled_by_zero(self):
        """0 表示不回传工具结果，保持默认文本模式（不产生 tool 消息）。"""
        messages = round_entry_to_context_messages(self._tool_round_entry(), max_tool_result_length=0)
        self.assertEqual(len(messages), 2)
        self.assertEqual(messages[1]["role"], "assistant")
        self.assertIn("[调用工具] run_pipe_command({})", messages[1]["content"])
        self.assertNotIn("tool_calls", messages[1])
        self.assertTrue(all(message.get("role") != "tool" for message in messages))

    def test_round_entry_to_context_messages_tool_result_missing_call_id_fallback(self):
        """tool 事件缺少 tool_call_id 时回退挂到最近一次工具调用，不丢失结果。"""
        round_entry = {
            "question": "查时间",
            "events": [
                {"role": "user", "content": "现在几点？"},
                {"role": "assistant", "tool_calls": [
                    {"function": {"name": "run_pipe_command", "arguments": "{}"}}
                ]},
                {"role": "tool", "content": "14:20"},
                {"role": "assistant", "content": "现在是 14:20"},
                {"role": "assistant", "done": "[DONE]"},
            ],
        }
        messages = round_entry_to_context_messages(round_entry, max_tool_result_length=-1)
        self.assertEqual(messages[1]["tool_calls"][0]["id"], "call_0")
        self.assertEqual(messages[2]["tool_call_id"], "call_0")
        self.assertEqual(messages[2]["content"], "14:20")


if __name__ == "__main__":
    unittest.main()
