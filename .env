# 聊天工具工作目录。由 change_chat_dir 接口更新，服务重启时从项目 .env 读取。
DEFAULT_CHAT_WORK_DIR="C:/Users/Administrator/Desktop/python学习录/main_study/large_model/agent_tool_sse"

# 服务默认启动宿主、端口
DEFAULT_SERVICE_HOST	= "0.0.0.0"
DEFAULT_SERVICE_PORT	= 48621

# 模型不使用工具次数达到此值时，将强制结束聊天
WITH_OUT_TOOL_COUNT     = 1



# （已废弃）历史轮数窗口 HISTORY_COMPACT_KEEP_ROUNDS 已移除：历史规模改由压缩触发阈值与
# 历史压缩目标（HISTORY_COMPACT_TARGET_TOKENS）共同控制

# 历史压缩：当历史上下文达到模型上下文上限的该比例时触发
HISTORY_COMPACT_TRIGGER_RATIO=0.8

# 工具调用输出结果超预算连续达到次数时结束任务触发值
HISTORY_COMPACT_MAX_OVERSIZED_REJECTIONS=3

# 单轮/跨轮摘要总预算 = 聊天窗口 × 该比例；单段摘要上限 = min(模型maxOutputTokens, 8k, 摘要预算)。
# 可由 POST /chat_config/history_compaction 的 summary_budget_ratio 配置。
HISTORY_COMPACT_SUMMARY_BUDGET_RATIO=0.15

# 单会话任务中并行工具调用数（工具调用线程池数量）
ONE_TASK_MAX_WORKERS=5

# /tools/list 实时探测 MCP 工具：并发服务数（上限会自动裁剪为 server 总数）
MCP_DISCOVERY_MAX_CONCURRENCY = 5

# /tools/list 单个 MCP 服务探测超时秒数（0 表示不超时，不建议）
MCP_DISCOVERY_TIMEOUT_SECONDS = 8



# 工具调用结果回传长度（0=不回传 · 负数=全部 · 正数=保留开头 N 字符）
HISTORY_TOOL_RESULT_RETURN_MAX_LENGTH=-1

# 思考过程回传长度（0=不回传 · 负数=全部 · 正数=保留末尾 N 字符）
REASONING_RETURN_MAX_LENGTH=-1

# 单工具结果超过阈值的拒绝系数，0=关闭
HISTORY_COMPACT_REJECT_OVERSIZED_FACTOR=1.5

# 工具调用超时秒数（0 表示不超时，不建议）
MCP_TOOL_CALL_TIMEOUT_SECONDS=300

# 工具调用流式阶段（模型 SSE 输出 tool_calls 期间）无输出超时秒数；部分服务商
# 在此阶段会无限卡住，超时后本次工具调用按失败反馈模型并继续任务（0=不限制）
TOOL_CALL_STREAM_TIMEOUT_SECONDS=300

# 视频文件读取最大秒数（钳制 5–3600，非法值回退默认 60）
VIDEO_MAX_READ_SECONDS=10

# ===================== 文档上传（原生文档 + 文本类文件） =====================
# 原生文档：会话生效模型 supportDocTypes 声明的类型（如 pdf/docx）按轮随请求发送原始文件
# 单个原生文档注入上限（字节，默认 20971520=20MB）；超出降级为文本口径；0=不限制
NATIVE_DOC_MAX_BYTES=20971520
# 单轮原生文档注入总量上限（字节，默认 41943040=40MB）；超出的按「新文件优先」降级为文本口径；0=不限制
NATIVE_DOC_TOTAL_MAX_BYTES=41943040
# 单轮原生文档注入数量上限（默认 3，至少 1）；超出的按「新文件优先」降级为文本口径
NATIVE_DOC_MAX_ITEMS=3
# 解析文本入库字符上限（默认 200000）：超出截断入库并标记，模型可按清单中给出的原文
# 绝对路径用 read_file 续读（防超大文本撑爆模型窗口）；0=不截断
FILE_TEXT_MAX_CHARS=200000

# 模型网络请求连续失败重试上限（达到该次数才终止任务；0 或负数=不限制，一直重试）
NETWORK_RETRY_MAX_ATTEMPTS=10
# 供应商请求硬限制：input_tokens + max_tokens 之和上限；超限的请求会被网关拒绝（HTTP 400 空响应体），
# 发送前预检据此提前拦截/自动降级 max_tokens；0 或负数 = 禁用预检（其他供应商无此限制时）
REQUEST_HARD_LIMIT_TOKENS=1048576

# 上游连接中断自动重试次数：单次发起请求内连续中断达到该次数才终止任务
# （每次请求正常完成后连续计数清零，重新计数；0 或负数=不限制，一直重试）
STREAM_TRUNCATION_MAX_RETRIES=10


# ===================== sub_agent 子智能体（docs/sub_agent_v1.md §10） =====================
# 总开关（false 时服务端不注入 sub_agent 工具定义，模型看不到）
SUB_AGENT_ENABLED=true
# 单个子任务的模型调用轮次上限（防子任务空转烧 token）
SUB_AGENT_MAX_ROUNDS=40
# 同一父轮并发子任务上限（超出排队执行）
SUB_AGENT_MAX_CONCURRENT=3
# 单个子任务整体超时秒数（0 或负数=不限制）；超时后以"已完成进展说明"返回父级
SUB_AGENT_TIMEOUT_SECONDS=900
# 子任务最终回复返回父级前的截断保护字符数（完整轨迹始终在 JSONL 子任务块内）
SUB_AGENT_REPLY_MAX_CHARS=30000


# 压缩失败重试：一次"尝试"=一条完整「压缩模型→（失败或返回空时）聊天模型」降级链；
# 整条链失败后固定间隔 1 秒再试；正数 N=最多 N 条链，耗尽后终止当前任务；0 或负数=不限制（一直重试直到手动停止）
COMPACTION_RETRY_MAX_ATTEMPTS=5

# ===================== 子智能体交付保障重试（聊天设置弹窗可配） =====================
# 空收尾重试上限：子任务最终回复为空时注入内部消息让子模型再次交付；0 或负数=不限制（仍受轮次/超时硬封顶）
SUB_AGENT_FINAL_REPLY_RETRY_MAX=3
# 断流续跑上限：子任务模型流式调用出错后注入内部消息从已有进度继续；0 或负数=不限制（仍受轮次/超时硬封顶）
SUB_AGENT_STREAM_ERROR_RETRY_MAX=3
# 计划未完成提醒次数：子任务收尾时 todo 未完成则提醒续做；每次完整工具执行轮后额度重置；0=关闭提醒，负数=不限制
SUB_AGENT_TODO_REMIND_MAX=3

# 历史压缩目标（tokens）：>0 时把"历史部分"压到该值以内（与触发阈值无关，压低长任务单次输入成本）；
# 实际会夹取到窗口派生上下限（<500k 窗口时 8% 下限、≥500k 时 40k 下限、40% 上限）；0=不设目标
HISTORY_COMPACT_TARGET_TOKENS=60000


# ===================== 访客用户（账号体系接入前的过渡配置） =====================
# 全局显示名：前端侧边栏底部点击名字即可修改，保存时由后端写入本文件（POST /user/profile）。
# 留空或删除该键 = 回退默认「访客用户」；最长 32 个字符。
# USER_NAME = "访客用户"
USER_NAME=""


# 百度搜索 api-key
# BAIDU_API_KEY           = "bce-baidu-AccessKey"
BAIDU_API_KEY           = "bce-baidu-AccessKey"
# SearXNG（免费开源）搜索
SEARXNG_URL             = "https://searx.be/search"
